# Orion Bets — the site lives in /public. This file makes https://orionbets.co/ load it.
Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.env|composer\.(json|lock)|docker-compose\.ya?ml)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP_HOST} cpanel\.site$ [NC]
    RewriteRule ^ https://orionbets.co%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.orionbets\.co$ [NC]
    RewriteRule ^ https://orionbets.co%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^orionbets\.co$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://orionbets.co%{REQUEST_URI} [L,R=301]

    RewriteRule ^(\.env|composer\.(json|lock)|docker-compose\.ya?ml)$ - [F,L]
    RewriteRule ^(app|bin|config|database|docker|routes|storage|vendor|cgi-bin)(/|$) - [F,L]

    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
