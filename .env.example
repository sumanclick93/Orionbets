APP_NAME=Orion Bets
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=base64:change-this-to-a-random-32-char-key!!
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
# Docker Compose: db
# cPanel / native PHP: localhost
DB_HOST=db
DB_PORT=3306
DB_DATABASE=edgeplay
DB_USERNAME=edgeplay
DB_PASSWORD=edgeplay

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@edgeplay.local
MAIL_FROM_NAME=Orion Bets

SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect URI must match the OAuth2 redirect registered on the Discord app.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Upgrade.Chat API (optional). Used to confirm orders and validate webhook events.
# Create keys at https://upgrade.chat/developers
UPGRADECHAT_CLIENT_ID=
UPGRADECHAT_CLIENT_SECRET=
# Optional shared secret. If set, webhooks must send it as X-Upgrade-Chat-Secret or ?secret=
UPGRADECHAT_WEBHOOK_SECRET=

# PayPal REST API (Smart Buttons on-site checkout). Create an app at https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox

# Everflow affiliate tracking. Use your tracking domain (no https://), e.g. track.example.com
EVERFLOW_TRACKING_DOMAIN=
EVERFLOW_NID=
EVERFLOW_OFFER_ID=
EVERFLOW_ADVERTISER_ID=
EVERFLOW_AFFILIATE_ID=
# Optional custom event ids for funnel postbacks (create these as additional events in Everflow)
EVERFLOW_REBILL_EVENT_ID=
EVERFLOW_LEAD_EVENT_ID=
EVERFLOW_CHECKOUT_EVENT_ID=
# Optional override. Default: https://www.{EVERFLOW_TRACKING_DOMAIN}/SP?_ef_transaction_id={transaction_id}&amount={amount}&order_id={order_id}&currency={currency}
EVERFLOW_POSTBACK_URL=

# Action Network (https://www.actionnetwork.com) — sync scoreboard, playbook picks, and profile ROI.
# User ID is the numeric id from an Action Network profile URL.
# API key is optional. Leave blank to hit public scoreboard/user endpoints unauthenticated.
# Leagues: comma list, or blank / "all" for the full supported slate.
ACTION_NETWORK_USER_ID=
ACTION_NETWORK_API_KEY=
ACTION_NETWORK_LEAGUES=nfl,ncaaf,nba,ncaab,mlb,nhl,soccer,wnba,ufc,pga,tennis
